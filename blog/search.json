---
layout: null
---
[{% for post in site.posts %}{% assign kind = post.content_type | default: 'development' %}{% if post.topic_id %}{% assign kind = 'cs' %}{% endif %}{"title":{{ post.title | jsonify }},"url":{{ post.url | relative_url | jsonify }},"kind":{{ kind | jsonify }},"kind_label":{{ site.data.content_types[kind] | jsonify }},"category":{{ post.categories.first | jsonify }},"date":{{ post.date | date: '%Y.%m.%d' | jsonify }},"text":{{ post.content | strip_html | normalize_whitespace | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
